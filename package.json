{
  "name": "tytup-backend",
  "version": "1.0.0",
  "description": "Minimal self-hosted video hosting backend: upload, ffmpeg HLS transcoding, streaming",
  "main": "build/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "cross-env TEST_VARIABLE=TEST_VALUE concurrently \"nodemon\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "encrypt-video": "ts-node src/scripts/encrypt-video.ts"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "busboy": "^1.6.0",
    "fluent-ffmpeg": "^2.1.2",
    "http-attach": "^1.0.0",
    "pg": "^8.11.1",
    "reflect-metadata": "^0.1.13",
    "typeorm": "^0.3.17",
    "uuid": "^9.0.0",
    "zlib": "^1.0.5"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.0",
    "@types/fluent-ffmpeg": "^2.1.21",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.2.3",
    "@types/pg": "^8.10.2",
    "@types/qs": "^6.9.7",
    "@types/react": "^18.2.6",
    "@types/react-dom": "^18.2.4",
    "@types/uuid": "^9.0.1",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "eslint": "^8.41.0",
    "husky": "^8.0.3",
    "nodemon": "^2.0.22",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "@types"
    ],
    "ext": "ts",
    "exec": "ts-node src/index.ts"
  }
}
